# Context-Aware Desktop File Organization Automation - Configuration
# Copy this file to .env to override local default paths and settings.

# Default target directory to scan (leave empty for system Downloads folder)
ORGANIZER_DEFAULT_SCAN_DIR=

# Default conflict resolution strategy: rename, skip, overwrite
ORGANIZER_CONFLICT_RESOLUTION=rename

# Duplicate handling strategy: quarantine, report_only, skip
ORGANIZER_DUPLICATE_STRATEGY=report_only

# Default date grouping: none, year, year_month, full_date
ORGANIZER_DATE_GROUPING=year_month

# SQLite database path for operation audit logs and rules
ORGANIZER_DB_PATH=file_organizer.db

# Enable verbose logging (DEBUG, INFO, WARNING, ERROR)
ORGANIZER_LOG_LEVEL=INFO
